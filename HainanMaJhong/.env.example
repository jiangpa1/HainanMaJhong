# ============================================================================
#  .env —— 复制本文件为 .env 后填真实值。
#  本地跑：run-local.ps1 会读它并注入环境变量（默认连内网 192.168.133.128）。
#  云端跑：application-prod.yml 里的 spring.config.import 会读【运行目录】下的 .env，
#          所以 systemd 必须写 WorkingDirectory=<.env 所在目录>。
#  .env 已被 .gitignore 忽略，不会进仓库；别把它提交上去。
#
#  格式就是 KEY=VALUE，一行一个，# 开头是注释，值不要加空格、不要加引号。
# ============================================================================

# ---------- 必填（没有默认值，缺任何一个应用直接起不来）----------

# MySQL 密码
DB_PASSWORD=

# Redis 密码（Redis 没设密码就写空值，但云上必须设）
REDIS_PASSWORD=

# 签发 JWT 的密钥：HS256 要求 >= 32 字节（256 bit），否则启动报 WeakKeyException。
# 生成一条 48 字节的随机串（Linux）：
#   openssl rand -base64 48
# 生成一条（Windows PowerShell）：
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# 注意：换了密钥，所有已登录用户的 token 立刻失效（会退回登录页），这是正常现象。
JWT_SECRET=

# ---------- 云端常用（本地开发不用动，application-prod.yml 里有默认值）----------

# 数据库地址。同机就是 127.0.0.1；用云数据库就写它的内网地址（别写公网地址）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hainan_majong
DB_USERNAME=root
# 也可以整体覆盖 JDBC URL（写了它，上面 DB_HOST/DB_PORT/DB_NAME 就被忽略）
# 库不存在时应用启动会告警，需要先手工 CREATE DATABASE hainan_majong DEFAULT CHARSET utf8mb4;
# 表结构不用建：启动时 SchemaInitializer 会幂等创建 user / game_sessions / game_rounds / game_round_scores
#DB_URL=jdbc:mysql://127.0.0.1:3306/hainan_majong?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true

# 连接池上限。单实例、几十人同时在线的话 10 足够；DB 是共享小规格实例时别开大。
DB_POOL_SIZE=10

# Redis 地址（同机 127.0.0.1；用云 Redis 写内网地址）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 多环境共用同一个 Redis 时用不同 db 隔离（0-15）
REDIS_DB=0

# ---------- 可选 ----------

# 对外端口（默认 8080；挂 nginx 反代时保持默认，让 nginx 转发到本机 8080）
#SERVER_PORT=8080

# token 有效期。云端想"更安全"就把 access 调短（但刷新逻辑要跟着确认）
#JWT_ACCESS_EXPIRATION=30m
#JWT_REFRESH_EXPIRATION=7d

# 大厅「下载APP」的安装包路径。填了就从服务器这份文件下载，替换安装包不用重新打包。
# 不填 / 文件不存在 → 下载 jar 内打包的 static/apk/jiangpahnmj.apk
#APP_APK_PATH=/opt/mahjong/jiangpahnmj.apk
