.env
*.local

# ---- IDE / 编辑器 ----
.idea/
*.iml
.vscode/

# ---- Eclipse ----
.settings/
.classpath
.project
.apt_generated
.factorypath

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 前端依赖：node_modules 有 4000+ 文件，绝不能入库 ----
node_modules/
.pnpm-store/

# ---- 探针生成的截图与 Python 缓存（随时可重跑生成，不入库）----
HainanMaJhong/docs/probe-*.png
HainanMaJhong/docs/ui-*.png
__pycache__/
*.pyc

# ---- 本地调试残留 ----
HainanMaJhong/game_log.txt

# 大厅「下载APP」源包（重复文件；打包用 src/main/resources/static/apk/ 那份）
/HainanMaJhong/jiangpahnmj.apk

# ---- 架构改造回归基线 / 本地运行日志（含真实账号与房间码，只本地留档）----
docs/baseline-*
docs/stage0-*
docs/stage1-*
docs/local-*
backup-arch/
